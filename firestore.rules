rules_version = '2';
// LabLens stores only redacted, structured results, and only for the signed-in owner.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/reports/{reportId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.id == reportId
        && !('redactedText' in request.resource.data)
        && request.resource.data.rows is list
        && request.resource.data.rows.size() <= 200
        && request.resource.size() < 900000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
