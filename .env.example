# Firebase web app config (Firebase console → Project settings → Your apps → Web app → SDK setup and configuration).
# These identify your project; they are not secrets, but keep real values out of git anyway (.env.local is ignored).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic): reCAPTCHA Enterprise *site key* (public).
VITE_RECAPTCHA_ENTERPRISE_KEY=

# Local development only: print an App Check debug token in the console that you then register in the console.
# Never set this in a production build.
VITE_APPCHECK_DEBUG=false
